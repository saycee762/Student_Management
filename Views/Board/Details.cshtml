    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.BoardCode)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.BoardCode)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Make)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Make)</dd>
